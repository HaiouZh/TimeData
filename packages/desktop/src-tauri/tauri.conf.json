{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TimeData",
  "version": "0.1.0",
  "identifier": "icu.yanzhou.timedata",
  "build": {
    "beforeBuildCommand": "pnpm --filter @timedata/client build:mobile",
    "beforeDevCommand": "pnpm --filter @timedata/client build:mobile",
    "frontendDist": "../../client/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TimeData",
        "width": 1100,
        "height": 800,
        "minWidth": 380,
        "minHeight": 480,
        "visible": true,
        "center": true
      },
      {
        "label": "capture",
        "url": "index.html?window=capture",
        "title": "TimeData 速记",
        "width": 600,
        "height": 120,
        "visible": false,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
