# 生产模式下必须设置；本地开发如需无鉴权旁路，显式设置 ALLOW_UNAUTHENTICATED_DEV=1
AUTH_TOKEN=
# 可选：窄域 agent token，仅 /api/agent/*（任务状态回写、任务轨道 ingest）接受；不设时该作用域仍可用 master AUTH_TOKEN。
# 生成：openssl rand -base64 32。一切给 agent/脚本/对话的场合只用这把，master 绝不外发。
# AGENT_TOKEN=
# ALLOW_UNAUTHENTICATED_DEV=1

# CORS 白名单，逗号分隔，不要带空格；未设置时跨域 /api/* 默认拒绝（fail-closed）
# 这里只需填**网页域名**。手机壳（Android/iOS）与桌面壳（Tauri）的 origin 由壳运行时写死、
# 部署者无从得知，已在 packages/server/src/middleware/cors.ts 的 SHELL_ORIGINS 内置放行，不必也不用列。
# 注意：docker-compose.yml 的 environment: 块必须显式列出 `- ALLOWED_ORIGINS=${ALLOWED_ORIGINS:-}`，
# 否则就算 .env 写了，变量也进不去容器。
ALLOWED_ORIGINS=https://your-domain.example.com

DB_PATH=/app/data/timedata.db
PORT=3000

# Watchtower HTTP API token；生产部署必须设置为随机长字符串。
WATCHTOWER_TOKEN=

# TimeData 镜像 tag；默认 latest，可 pin 到指定版本。
TIMEDATA_IMAGE_TAG=latest

# 镜像来源仓库，用来查最新版本（GitHub owner/repo）
UPDATE_REPO=HaiouZh/TimeData

# 可选：GitHub API Token，用于提高 /api/version 查询限额
# GITHUB_TOKEN=github_pat_xxx

# 日记功能：Obsidian vault 在宿主机上的目录，compose 会把它挂载到容器 /app/vault。
# 默认 ./vault（即部署目录下的 vault/）；vault 内容由你自行同步到该目录（如 OneDrive/rclone）。
# DIARY_VAULT_HOST_DIR=/opt/timedata/vault
# 容器内 vault 路径，默认 /app/vault，一般不用改；显式设为空可停用日记功能（API 返回未启用）。
# DIARY_VAULT_DIR=/app/vault

# GeoLite2 自动更新（可选）。在 https://www.maxmind.com 注册免费账号获取。
# 以下三行都填齐后取消 COMPOSE_PROFILES 行的注释才生效；未填凭据时 geoipupdate 容器会启动失败并崩溃重启循环。
# COMPOSE_PROFILES=geoip
GEOIPUPDATE_ACCOUNT_ID=
GEOIPUPDATE_LICENSE_KEY=
